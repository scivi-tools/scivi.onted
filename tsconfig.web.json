{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": [
    "src/editor/**/*.ts",
    "src/editor/**/*.vue",
    "src/core/**/*.ts",
    "src/platform/types.ts",
    "src/platform/electron/renderer.ts",
    "tests/editor/**/*.ts"
  ]
}
